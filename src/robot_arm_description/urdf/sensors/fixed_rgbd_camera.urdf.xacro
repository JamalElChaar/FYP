<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Eye-to-hand mount. Measure these values on the physical rig before motion. -->
  <xacro:arg name="camera_x" default="0.22"/>
  <xacro:arg name="camera_y" default="-0.30"/>
  <xacro:arg name="camera_z" default="0.50"/>
  <xacro:arg name="camera_pitch" default="0.872664626"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="use_tray" default="false"/>

  <!-- The camera's +X axis points toward the work area (+Y of base_link).
       Positive pitch points it downward. The Astra driver owns its internal
       color/depth transforms on hardware, so these frames are simulated only. -->
  <link name="camera_mast_link">
    <!-- The printed tray supplies the complete mast and cradle geometry. -->
    <xacro:unless value="$(arg use_tray)">
      <visual>
        <origin xyz="0 0 0.25"/>
        <geometry><cylinder radius="0.005" length="0.5"/></geometry>
        <material name="LightGrey"><color rgba="0.7 0.7 0.7 1"/></material>
      </visual>
      <visual>
        <geometry><box size="0.15 0.10 0.06"/></geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.25"/>
        <geometry><cylinder radius="0.005" length="0.5"/></geometry>
      </collision>
      <collision>
        <geometry><box size="0.15 0.10 0.06"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.25"/>
        <mass value="0.25"/>
        <inertia ixx="0.00521" ixy="0" ixz="0"
                 iyy="0.00521" iyz="0" izz="0.0001"/>
      </inertial>
    </xacro:unless>
  </link>
  <joint name="base_to_camera_mast" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="camera_mast_link"/>
    <origin xyz="$(arg camera_x) $(arg camera_y) 0"/>
  </joint>

  <!-- Visual approximation of the Orbbec Astra Pro: 165 x 30 x 40 mm.
       +X is the viewing direction; the long dimension runs along camera +Y.
       The three optical elements are visual only; the Gazebo sensor remains
       attached to camera_link at its calibrated origin. -->
  <xacro:macro name="astra_lens" params="y outer_radius">
    <visual>
      <origin xyz="0.0165 ${y} 0" rpy="0 1.570796327 0"/>
      <geometry><cylinder radius="${outer_radius}" length="0.003"/></geometry>
      <material name="astra_lens_ring"><color rgba="0.27 0.29 0.32 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.0181 ${y} 0" rpy="0 1.570796327 0"/>
      <geometry><cylinder radius="${outer_radius * 0.72}" length="0.001"/></geometry>
      <material name="astra_lens_glass"><color rgba="0.015 0.035 0.075 1"/></material>
    </visual>
  </xacro:macro>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.030 0.165 0.040"/></geometry>
      <material name="astra_body"><color rgba="0.08 0.085 0.09 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.0155 0 0"/>
      <geometry><box size="0.001 0.155 0.033"/></geometry>
      <material name="astra_front"><color rgba="0.035 0.04 0.045 1"/></material>
    </visual>
    <xacro:astra_lens y="0.056" outer_radius="0.010"/>
    <xacro:astra_lens y="0.0" outer_radius="0.007"/>
    <xacro:astra_lens y="-0.056" outer_radius="0.010"/>
    <collision>
      <geometry><box size="0.030 0.165 0.040"/></geometry>
    </collision>
    <inertial>
      <mass value="0.31"/>
      <inertia ixx="0.000745" ixy="0" ixz="0"
               iyy="0.000065" iyz="0" izz="0.000727"/>
    </inertial>
  </link>
  <joint name="camera_mast_to_camera" type="fixed">
    <parent link="camera_mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.01 $(arg camera_z)"
            rpy="0 $(arg camera_pitch) 1.570796327"/>
  </joint>

  <xacro:if value="$(arg use_gazebo)">
    <!-- Optical convention: +Z forward, +X right, +Y down. -->
    <link name="camera_color_frame"/>
    <joint name="camera_color_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_frame"/>
      <origin xyz="0 0 0"/>
    </joint>
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_color_frame"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>
    <link name="camera_depth_frame"/>
    <joint name="camera_depth_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_frame"/>
      <origin xyz="0 0 0"/>
    </joint>
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_depth_frame"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="camera_head" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.15</near><far>2.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <topic>camera_head</topic>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
